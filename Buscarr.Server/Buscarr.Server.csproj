<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Buscarr.Server</RootNamespace>
    <ClientRoot>$(MSBuildProjectDirectory)/../Buscarr.Client/</ClientRoot>
    <SpaRoot>$(ClientRoot)</SpaRoot>
    <SpaProxyLaunchCommand>npm run dev</SpaProxyLaunchCommand>
    <SpaProxyServerUrl>http://localhost:5173</SpaProxyServerUrl>
    <UserSecretsId>75271d3d-3e23-4b50-b16f-616d36338a87</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <ClientSource Include="$(ClientRoot)src/**" />
    <ClientSource Include="$(ClientRoot)index.html;$(ClientRoot)package.json;$(ClientRoot)package-lock.json;$(ClientRoot)vite.config.ts;$(ClientRoot)tsconfig.json;$(ClientRoot)eslint.config.js" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.SpaProxy" Version="10.0.13" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>

  <Target Name="InstallClientDependencies" Condition="!Exists('$(ClientRoot)node_modules') and '$(SkipClient)' != 'true'">
    <Exec Command="npm install" WorkingDirectory="$(ClientRoot)" />
  </Target>

  <Target Name="BuildClient" BeforeTargets="Build" DependsOnTargets="InstallClientDependencies" Inputs="@(ClientSource)" Outputs="$(MSBuildProjectDirectory)/wwwroot/index.html" Condition="'$(SkipClient)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="$(ClientRoot)" />
  </Target>

</Project>
